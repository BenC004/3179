{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Parallel coordinates comparing demographic and school enrolment changes by state.",
  "width": 800,
  "height": 500,
  "padding": 20,
  "title": {
    "text": "Do enrolment changes follow the child-population trend?",
    "subtitle": [
      "Percentage change by state, 2017 - 2025. All three axes use the same scale.",
      "Population aged 5 - 14 is used for comparison; it does not exactly match primary or secondary school ages.",
      "Select a state or hover over a line to highlight its profile."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "offset": 40
  },
  "signals": [
    {
      "name": "selectedState",
      "value": "All states",
      "bind": {
        "input": "select",
        "name": "Highlight state: ",
        "options": [
          "All states", "Johor", "Kedah", "Kelantan", "Melaka",
          "Negeri Sembilan", "Pahang", "Perak", "Perlis", "Pulau Pinang",
          "Sabah", "Sarawak", "Selangor", "Terengganu",
          "W.P. Kuala Lumpur", "W.P. Labuan", "W.P. Putrajaya"
        ],
        "labels": [
          "All states", "Johor", "Kedah", "Kelantan", "Melaka",
          "Negeri Sembilan", "Pahang", "Perak", "Perlis", "Pulau Pinang",
          "Sabah", "Sarawak", "Selangor", "Terengganu",
          "Kuala Lumpur", "Labuan", "Putrajaya"
        ]
      }
    },
    {
      "name": "hoveredState",
      "value": null,
      "on": [
        {"events": "@stateLines:mouseover", "update": "datum.state"},
        {"events": "@stateLines:mouseout", "update": "null"},
        {"events": "@statePoints:mouseover", "update": "datum.state"},
        {"events": "@statePoints:mouseout", "update": "null"}
      ]
    }
  ],
  "data": [
    {
      "name": "population",
      "url": "../source2/population_state.csv", "format": {"type": "csv", "parse": {"population": "number"}},
      "transform": [
        {"type": "filter", "expr": "datum.sex === 'both' && datum.ethnicity === 'overall'"},
        {"type": "filter", "expr": "datum.age === '5-9' || datum.age === '10-14'"},
        {"type": "formula", "expr": "toNumber(substring(datum.date, 0, 4))", "as": "Year"},
        {"type": "filter", "expr": "datum.Year === 2017 || datum.Year === 2025"},
        {"type": "formula", "expr": "datum.Year === 2017 ? datum.population * 1000 : 0", "as": "Baseline"},
        {"type": "formula", "expr": "datum.Year === 2025 ? datum.population * 1000 : 0", "as": "Latest"},
        {
          "type": "aggregate",
          "groupby": ["state"],
          "fields": ["Baseline", "Latest"],
          "ops": ["sum", "sum"],
          "as": ["Children2017", "Children2025"]
        },
        {"type": "filter", "expr": "datum.Children2017 > 0 && datum.Children2025 > 0"},
        {"type": "formula", "expr": "(datum.Children2025 - datum.Children2017) / datum.Children2017", "as": "ChildGrowth"}
      ]
    },
    {
      "name": "comparison",
      "url": "../source1/enrolment_school_district.csv",
      "format": {"type": "csv", "parse": {"students": "number"}},
      "transform": [
        {"type": "filter", "expr": "datum.state !== 'Malaysia'"},
        {"type": "filter", "expr": "datum.district === 'All Districts' && datum.sex === 'both'"},
        {"type": "filter", "expr": "datum.stage === 'primary' || datum.stage === 'secondary'"},
        {"type": "formula", "expr": "toNumber(substring(datum.date, 0, 4))", "as": "Year"},
        {"type": "filter", "expr": "datum.Year === 2017 || datum.Year === 2025"},
        {"type": "formula", "expr": "datum.stage === 'primary' && datum.Year === 2017 ? datum.students : 0", "as": "P2017"},
        {"type": "formula", "expr": "datum.stage === 'primary' && datum.Year === 2025 ? datum.students : 0", "as": "P2025"},
        {"type": "formula", "expr": "datum.stage === 'secondary' && datum.Year === 2017 ? datum.students : 0", "as": "S2017"},
        {"type": "formula", "expr": "datum.stage === 'secondary' && datum.Year === 2025 ? datum.students : 0", "as": "S2025"},
        {
          "type": "aggregate",
          "groupby": ["state"],
          "fields": ["P2017", "P2025", "S2017", "S2025"],
          "ops": ["sum", "sum", "sum", "sum"],
          "as": ["Primary2017", "Primary2025", "Secondary2017", "Secondary2025"]
        },
        {"type": "filter", "expr": "datum.Primary2017 > 0 && datum.Primary2025 > 0 && datum.Secondary2017 > 0 && datum.Secondary2025 > 0"},
        {"type": "formula", "expr": "(datum.Primary2025 - datum.Primary2017) / datum.Primary2017", "as": "PrimaryGrowth"},
        {"type": "formula", "expr": "(datum.Secondary2025 - datum.Secondary2017) / datum.Secondary2017", "as": "SecondaryGrowth"},
        {"type": "lookup", "from": "population", "key": "state", "fields": ["state"], "values": ["ChildGrowth"], "as": ["ChildGrowth"]},
        {"type": "filter", "expr": "isValid(datum.ChildGrowth)"},
        {"type": "formula", "expr": "replace(datum.state, 'W.P. ', '')", "as": "StateLabel"}
      ]
    },
    {
      "name": "profiles",
      "source": "comparison",
      "transform": [
        {"type": "fold", "fields": ["ChildGrowth", "PrimaryGrowth", "SecondaryGrowth"], "as": ["Measure", "Growth"]},
        {"type": "formula", "expr": "datum.Measure === 'ChildGrowth' ? 0 : datum.Measure === 'PrimaryGrowth' ? 1 : 2", "as": "MeasureOrder"},
        {"type": "collect", "sort": {"field": ["state", "MeasureOrder"], "order": ["ascending", "ascending"]}}
      ]
    },
    {
      "name": "headers",
      "values": [
        {"Measure": "ChildGrowth", "Label": "Population aged 5 - 14"},
        {"Measure": "PrimaryGrowth", "Label": "Primary enrolment"},
        {"Measure": "SecondaryGrowth", "Label": "Secondary enrolment"}
      ]
    }
  ],
  "scales": [
    {"name": "x", "type": "point", "domain": ["ChildGrowth", "PrimaryGrowth", "SecondaryGrowth"], "range": [70, {"signal": "width - 80"}]},
    {"name": "growth", "type": "linear", "domain": {"data": "profiles", "field": "Growth"}, "range": "height", "zero": true, "nice": true}
  ],
  "axes": [
    {
      "orient": "left",
      "scale": "growth",
      "offset": {"scale": "x", "value": "ChildGrowth", "mult": -1},
      "format": ".0%",
      "tickCount": 8,
      "domain": true,
      "grid": false
    },
    {
      "orient": "left",
      "scale": "growth",
      "offset": {"scale": "x", "value": "PrimaryGrowth", "mult": -1},
      "format": ".0%",
      "tickCount": 8,
      "domain": true,
      "grid": false
    },
    {
      "orient": "left",
      "scale": "growth",
      "offset": {"scale": "x", "value": "SecondaryGrowth", "mult": -1},
      "format": ".0%",
      "tickCount": 8,
      "domain": true,
      "grid": false
    }
  ],
  "marks": [
    {
      "type": "rule",
      "interactive": false,
      "encode": {
        "update": {
          "x": {"scale": "x", "value": "ChildGrowth"},
          "x2": {"scale": "x", "value": "SecondaryGrowth"},
          "y": {"scale": "growth", "value": 0},
          "stroke": {"value": "#999999"},
          "strokeDash": {"value": [4, 4]},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "stateProfile",
          "data": "profiles",
          "groupby": ["state"]
        }
      },
      "encode": {
        "update": {
          "zindex": {"signal": "datum.state === selectedState || datum.state === hoveredState ? 1 : 0"}
        }
      },
      "marks": [
        {
          "name": "stateLines",
          "type": "line",
          "from": {"data": "stateProfile"},
          "sort": {"field": "datum.MeasureOrder"},
          "encode": {
            "update": {
              "x": {"scale": "x", "field": "Measure"},
              "y": {"scale": "growth", "field": "Growth"},
              "stroke": {"signal": "datum.state === selectedState || datum.state === hoveredState || selectedState === 'All states' ? '#756BB1' : '#BBBBBB'"},
              "strokeWidth": {"signal": "datum.state === selectedState || datum.state === hoveredState ? 3 : 1.5"},
              "strokeOpacity": {"signal": "datum.state === selectedState || datum.state === hoveredState ? 1 : selectedState === 'All states' ? 0.45 : 0.3"},
              "tooltip": {
                "signal": "{'State': datum.StateLabel, 'Child population growth': format(datum.ChildGrowth, '+.1%'), 'Primary enrolment growth': format(datum.PrimaryGrowth, '+.1%'), 'Secondary enrolment growth': format(datum.SecondaryGrowth, '+.1%')}"
              }
            }
          }
        }
      ]
    },
    {
      "name": "statePoints",
      "type": "symbol",
      "from": {"data": "profiles"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "Measure"},
          "y": {"scale": "growth", "field": "Growth"},
          "size": {"signal": "datum.state === selectedState || datum.state === hoveredState ? 90 : 35"},
          "fill": {"signal": "datum.state === selectedState || datum.state === hoveredState || selectedState === 'All states' ? '#756BB1' : '#BBBBBB'"},
          "fillOpacity": {"signal": "datum.state === selectedState || datum.state === hoveredState ? 1 : 0.35"},
          "stroke": {"value": "#FFFFFF"},
          "strokeWidth": {"value": 0.5},
          "tooltip": {
            "signal": "{'State': datum.StateLabel, 'Child population growth': format(datum.ChildGrowth, '+.1%'), 'Primary enrolment growth': format(datum.PrimaryGrowth, '+.1%'), 'Secondary enrolment growth': format(datum.SecondaryGrowth, '+.1%')}"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {"data": "headers"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "Measure"},
          "y": {"value": -15},
          "text": {"field": "Label"},
          "align": {"value": "center"},
          "baseline": {"value": "bottom"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#222222"}
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "axis": {"labelFontSize": 11, "labelPadding": 6, "domainColor": "#CCCCCC", "tickColor": "#CCCCCC"}
  }
}