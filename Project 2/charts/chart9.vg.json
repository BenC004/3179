{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 700,
  "height": 400,
  "title": {
    "text": {"expr": "'How have annual births changed in ' + replace(selectedState, 'W.P. ', '') + '?'"},
    "subtitle": [
      "Registered live births, 2017 - 2024",
      "Births indicate future school demand, rather than current enrolment."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13
  },
  "data": {"url": "../source2/birth_state.csv", "format": {"type": "csv", "parse": {"abs": "number"}}},
  "params": [
    {
      "name": "selectedState",
      "value": "Malaysia",
      "bind": {
        "input": "select",
        "name": "Selected state: ",
        "options": [
          "Malaysia", "Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan",
          "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak",
          "Selangor", "Terengganu", "W.P. Kuala Lumpur", "W.P. Labuan", "W.P. Putrajaya"
        ],
        "labels": [
          "Malaysia", "Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan",
          "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak",
          "Selangor", "Terengganu", "Kuala Lumpur", "Labuan", "Putrajaya"
        ]
      }
    }
  ],
  "transform": [
    {"filter": "selectedState === 'Malaysia' || datum.state === selectedState"},
    {"calculate": "toNumber(substring(datum.date, 0, 4))", "as": "Year"},
    {"filter": "datum.Year >= 2017 && datum.Year <= 2024"},
    {
      "aggregate": [{"op": "sum", "field": "abs", "as": "Births"}],
      "groupby": ["Year"]
    },
    {"calculate": "replace(selectedState, 'W.P. ', '')", "as": "Location"}
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "scale": {"domain": [2017, 2024], "nice": false},
      "axis": {
        "title": "Year",
        "format": "d",
        "values": [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024],
        "grid": false
      }
    },
    "y": {
      "field": "Births",
      "type": "quantitative",
      "scale": {"zero": true},
      "axis": {
        "title": "Live births",
        "format": "~s",
        "gridColor": "#EEEEEE"
      }
    },
    "tooltip": [
      {"field": "Location", "type": "nominal"},
      {"field": "Year", "type": "quantitative", "format": "d"},
      {"field": "Births", "type": "quantitative", "title": "Live births", "format": ",.0f"}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#237A57"
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 55,
        "opacity": 1,
        "color": "#237A57"
      }
    },
    {
      "transform": [
        {"filter": "datum.Year === 2024"}
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "dx": -8,
        "dy": 18,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#237A57"
      },
      "encoding": {
        "text": {
          "field": "Births",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 13, "domain": false, "tickColor": "#CCCCCC"}
  }
}