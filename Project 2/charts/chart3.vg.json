{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Where did school enrolment grow or decline?",
    "subtitle": [
      "Government primary and secondary schools, 2017 - 2025",
      "Colour scale capped at ±20%; hover for exact values."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13
  },
  "width": 800,
  "height": 500,
  "data": {"url": "../source1/enrolment_school_district.csv", "format": {"type": "csv", "parse": {"students": "number"}}},
  "transform": [
    {"filter": "datum.state !== 'Malaysia'"},
    {"filter": "datum.district === 'All Districts' && datum.sex === 'both'"},
    {"filter": "datum.stage === 'primary' || datum.stage === 'secondary'"},
    {"calculate": "toNumber(substring(datum.date, 0, 4))", "as": "Year"},
    {"filter": "datum.Year === 2017 || datum.Year === 2025"},
    {"calculate": "datum.Year === 2017 ? datum.students : 0", "as": "Baseline"},
    {"calculate": "datum.Year === 2025 ? datum.students : 0", "as": "Latest"},
    {
      "aggregate": [
        {"op": "sum", "field": "Baseline", "as": "Students 2017"},
        {"op": "sum", "field": "Latest", "as": "Students 2025"}
      ],
      "groupby": ["state"]
    },
    {"calculate": "datum['Students 2025'] - datum['Students 2017']", "as": "Change"},
    {"calculate": "datum['Students 2017'] > 0 ? datum.Change / datum['Students 2017'] : null", "as": "Growth"},
    {"calculate": "replace(datum.state, 'W.P. ', '')", "as": "State Label"},
    {
      "lookup": "state",
      "from": {
        "data": {"url": "../maps/administrative_1_state.geojson", "format": {"type": "json", "property": "features"}},
        "key": "properties.state"
      },
      "as": "Boundary"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "values": [
            {"state": "Perlis", "lon": 100.23, "lat": 6.50},
            {"state": "Kedah", "lon": 100.65, "lat": 5.95},
            {"state": "Pulau Pinang", "lon": 100.18, "lat": 5.38},
            {"state": "Perak", "lon": 101.05, "lat": 4.65},
            {"state": "Kelantan", "lon": 102.15, "lat": 5.35},
            {"state": "Terengganu", "lon": 103.00, "lat": 4.85},
            {"state": "Pahang", "lon": 102.50, "lat": 3.70},
            {"state": "Selangor", "lon": 101.25, "lat": 3.35},
            {"state": "Negeri Sembilan", "lon": 102.20, "lat": 2.80},
            {"state": "Melaka", "lon": 102.30, "lat": 2.20},
            {"state": "Johor", "lon": 103.35, "lat": 1.95},
            {"state": "Sabah", "lon": 117.00, "lat": 5.30},
            {"state": "Sarawak", "lon": 113.40, "lat": 2.50},
            {"state": "W.P. Kuala Lumpur", "lon": 99.80, "lat": 3.10, "anchorLon": 101.69, "anchorLat": 3.14},
            {"state": "W.P. Putrajaya", "lon": 100.00, "lat": 2.40, "anchorLon": 101.70, "anchorLat": 2.93},
            {"state": "W.P. Labuan", "lon": 114.40, "lat": 5.70, "anchorLon": 115.24, "anchorLat": 5.30}
          ]
        },
        "key": "state",
        "fields": ["lon", "lat", "anchorLon", "anchorLat"]
      }
    },
    {
      "calculate": "datum.state === 'W.P. Kuala Lumpur' ? 'KL: ' + format(datum.Growth, '.1%') : datum.state === 'W.P. Putrajaya' ? 'Putrajaya: ' + format(datum.Growth, '.1%') : datum.state === 'W.P. Labuan' ? 'Labuan: ' + format(datum.Growth, '.1%') : format(datum.Growth, '.1%')",
      "as": "Growth Label"
    }
  ],
  "projection": {"type": "mercator"},
  "layer": [
    {
      "mark": {"type": "geoshape", "stroke": "#FFFFFF", "strokeWidth": 1},
      "encoding": {
        "shape": {"field": "Boundary", "type": "geojson"},
        "color": {
          "field": "Growth", "type": "quantitative",
          "scale": {"domain": [-0.2, 0, 0.2], "range": ["#A64B5B", "#F2F2F2", "#76B7B2"], "clamp": true},
          "legend": {
            "title": "Enrolment growth",
            "orient": "bottom",
            "direction": "horizontal",
            "format": ".0%",
            "values": [-0.2, -0.1, 0, 0.1, 0.2],
            "gradientLength": 250
          }
        },
        "tooltip": [
          {"field": "State Label", "type": "nominal", "title": "State"},
          {"field": "Students 2017", "type": "quantitative", "title": "Students in 2017", "format": ",.0f"},
          {"field": "Students 2025", "type": "quantitative", "title": "Students in 2025", "format": ",.0f"},
          {"field": "Change", "type": "quantitative", "title": "Change in students", "format": "+,.0f"},
          {"field": "Growth", "type": "quantitative", "title": "Enrolment growth", "format": "+.1%"}
        ]
      }
    },
    {
      "transform": [{"filter": "isValid(datum.anchorLon)"}],
      "mark": {"type": "rule", "color": "#777777", "strokeWidth": 0.8},
      "encoding": {
        "longitude": {"field": "anchorLon", "type": "quantitative"},
        "latitude": {"field": "anchorLat", "type": "quantitative"},
        "longitude2": {"field": "lon"},
        "latitude2": {"field": "lat"}
      }
    },
    {
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold", "color": "#FFFFFF", "stroke": "#FFFFFF", "strokeWidth": 3},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "Growth Label", "type": "nominal"}
      }
    },
    {
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold", "color": "#222222"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "Growth Label", "type": "nominal"},
        "tooltip": [
          {"field": "State Label", "type": "nominal", "title": "State"},
          {"field": "Students 2017", "type": "quantitative", "title": "Students in 2017", "format": ",.0f"},
          {"field": "Students 2025", "type": "quantitative", "title": "Students in 2025", "format": ",.0f"},
          {"field": "Growth", "type": "quantitative", "title": "Enrolment growth", "format": "+.1%"}
        ]
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "legend": {"labelFontSize": 12, "titleFontSize": 13}
  }
}