{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": {"expr": "'How has the young population in ' + replace(selectedState, 'W.P. ', '') + ' changed?'"},
    "subtitle": [
      "Population aged 0 - 24 by age group and sex, 2017 vs 2025",
      "Male on the left, female on the right. Both years use the same population scale."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13
  },
  "data": {"url": "../source2/population_state.csv", "format": {"type": "csv", "parse": {"population": "number"}}},
  "params": [
    {
      "name": "selectedState",
      "value": "Malaysia",
      "bind": {
        "input": "select",
        "name": "Selected state: ",
        "options": [
          "Malaysia", "Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan",
          "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak",
          "Selangor", "Terengganu", "W.P. Kuala Lumpur", "W.P. Labuan", "W.P. Putrajaya"
        ],
        "labels": [
          "Malaysia", "Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan",
          "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak",
          "Selangor", "Terengganu", "Kuala Lumpur", "Labuan", "Putrajaya"
        ]
      }
    }
  ],
  "transform": [
    {"filter": "datum.state !== 'Malaysia'"},
    {"filter": "selectedState === 'Malaysia' || datum.state === selectedState"},
    {"filter": "datum.ethnicity === 'overall'"},
    {"filter": "datum.sex === 'male' || datum.sex === 'female'"},
    {"filter": "indexof(['0-4', '5-9', '10-14', '15-19', '20-24'], datum.age) >= 0"},
    {"calculate": "toNumber(substring(datum.date, 0, 4))", "as": "Year"},
    {"filter": "datum.Year === 2017 || datum.Year === 2025"},
    {
      "aggregate": [{"op": "sum", "field": "population", "as": "Population Thousands"}],
      "groupby": ["Year", "age", "sex"]
    },
    {"calculate": "datum['Population Thousands'] * 1000", "as": "Population"},
    {
      "joinaggregate": [{"op": "sum", "field": "Population", "as": "Age Group Total"}],
      "groupby": ["Year", "age"]
    },
    {"calculate": "datum.sex === 'male' ? 'Male' : 'Female'", "as": "Sex"},
    {"calculate": "datum.sex === 'male' ? -datum.Population : datum.Population", "as": "Signed Population"},
    {"calculate": "-datum.Population", "as": "Negative Population"},
    {"calculate": "replace(selectedState, 'W.P. ', '')", "as": "Location"}
  ],
  "facet": {
    "column": {
      "field": "Year", "type": "ordinal",
      "sort": [2017, 2025],
      "header": {"title": null, "labelFontSize": 18, "labelFontWeight": "bold", "labelPadding": 15}
    }
  },
  "spacing": 40,
  "spec": {
    "width": 350,
    "height": 450,
    "encoding": {
      "x": {
        "field": "Signed Population", "type": "quantitative",
        "scale": {"zero": true, "nice": true},
        "axis": {
          "title": "Population",
          "labelExpr": "format(abs(datum.value), '~s')",
          "tickCount": 5,
          "labelOverlap": true,
          "labelPadding": 6,
          "titlePadding": 12,
          "grid": true,
          "gridColor": "#EEEEEE"
        }
      },
      "y": {
        "field": "age", "type": "ordinal",
        "sort": ["20-24", "15-19", "10-14", "5-9", "0-4"],
        "scale": {"paddingInner": 0.2, "paddingOuter": 0.1},
        "axis": {
          "title": "Age group",
          "labelPadding": 8,
          "ticks": false,
          "domain": false
        }
      }
    },
    "layer": [
      {
        "mark": {"type": "bar"},
        "encoding": {
          "x2": {"datum": 0},
          "color": {
            "field": "Sex", "type": "nominal",
            "scale": {"domain": ["Male", "Female"], "range": ["#4E79A7", "#CC7A91"]},
            "legend": {"title": null, "orient": "top"}
          },
          "tooltip": [
            {"field": "Location", "type": "nominal", "title": "Location"},
            {"field": "Year", "type": "quantitative", "title": "Year", "format": "d"},
            {"field": "age", "type": "ordinal", "title": "Age group"},
            {"field": "Sex", "type": "nominal", "title": "Sex"},
            {"field": "Population", "type": "quantitative", "title": "Population", "format": ",.0f"},
            {"field": "Age Group Total", "type": "quantitative", "title": "Male + female total in this age group", "format": ",.0f"}
          ]
        }
      },
      {
        "mark": {"type": "rule", "opacity": 0, "tooltip": null},
        "encoding": {
          "x": {
            "field": "Population", "type": "quantitative",
            "scale": {"zero": true, "nice": true},
            "axis": {
              "title": "Population",
              "labelExpr": "format(abs(datum.value), '~s')",
              "tickCount": 5,
              "labelOverlap": true,
              "labelPadding": 6,
              "titlePadding": 12,
              "grid": true,
              "gridColor": "#EEEEEE"
            }
          },
          "x2": {"field": "Negative Population"}
        }
      },
      {
        "mark": {
          "type": "text",
          "fontSize": 11,
          "fontWeight": "bold",
          "color": "#FFFFFF",
          "align": {"expr": "datum.sex === 'male' ? 'left' : 'right'"},
          "dx": {"expr": "datum.sex === 'male' ? 8 : -8"}
        },
        "encoding": {
          "text": {"field": "Population", "type": "quantitative", "format": ".3~s"}
        }
      },
      {
        "mark": {"type": "rule", "color": "#777777", "strokeWidth": 1},
        "encoding": {
          "x": {"datum": 0, "type": "quantitative"},
          "y": {"value": 0},
          "y2": {"value": 450}
        }
      }
    ]
  },
  "resolve": {
    "scale": {"x": "shared", "y": "shared", "color": "shared"}
  },
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 11, "titleFontSize": 13, "domain": false, "tickColor": "#CCCCCC"},
    "legend": {"labelFontSize": 12}
  }
}