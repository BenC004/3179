{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 650,
  "height": 450,
  "padding": 20,
  "title": {
    "text": "Is teacher growth keeping pace with enrolment growth?",
    "subtitle": [
      "Percentage change in government schools, 2017 - 2025",
      "Above the diagonal: teacher growth exceeds enrolment growth.",
      "Below the diagonal: enrolment growth exceeds teacher growth."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13
  },
  "signals": [
    {
      "name": "selectedState",
      "value": "All states",
      "bind": {
        "input": "select",
        "name": "Selected state: ",
        "options": [
          "All states", "Johor", "Kedah", "Kelantan", "Melaka",
          "Negeri Sembilan", "Pahang", "Perak", "Perlis", "Pulau Pinang",
          "Sabah", "Sarawak", "Selangor", "Terengganu",
          "W.P. Kuala Lumpur", "W.P. Labuan", "W.P. Putrajaya"
        ],
        "labels": [
          "All states", "Johor", "Kedah", "Kelantan", "Melaka",
          "Negeri Sembilan", "Pahang", "Perak", "Perlis", "Pulau Pinang",
          "Sabah", "Sarawak", "Selangor", "Terengganu",
          "Kuala Lumpur", "Labuan", "Putrajaya"
        ]
      }
    }
  ],
  "data": [
    {
      "name": "teachers",
      "url": "../source1/teachers_district.csv",
      "format": {
        "type": "csv",
        "parse": {"teachers": "number"}
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.state !== 'Malaysia' && datum.district === 'All Districts' && datum.sex === 'both'"
        },
        {
          "type": "filter",
          "expr": "datum.stage === 'primary' || datum.stage === 'secondary'"
        },
        {
          "type": "formula",
          "expr": "toNumber(substring(datum.date, 0, 4))",
          "as": "Year"
        },
        {
          "type": "filter",
          "expr": "datum.Year === 2017 || datum.Year === 2025"
        },
        {
          "type": "formula",
          "expr": "datum.Year === 2017 ? datum.teachers : 0",
          "as": "Baseline"
        },
        {
          "type": "formula",
          "expr": "datum.Year === 2025 ? datum.teachers : 0",
          "as": "Latest"
        },
        {
          "type": "aggregate",
          "groupby": ["state", "stage"],
          "fields": ["Baseline", "Latest"],
          "ops": ["sum", "sum"],
          "as": ["Teachers2017", "Teachers2025"]
        },
        {
          "type": "formula",
          "expr": "datum.state + '|' + datum.stage",
          "as": "JoinKey"
        }
      ]
    },
    {
      "name": "comparison",
      "url": "../source1/enrolment_school_district.csv",
      "format": {
        "type": "csv",
        "parse": {"students": "number"}
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.state !== 'Malaysia' && datum.district === 'All Districts' && datum.sex === 'both'"
        },
        {
          "type": "filter",
          "expr": "datum.stage === 'primary' || datum.stage === 'secondary'"
        },
        {
          "type": "formula",
          "expr": "toNumber(substring(datum.date, 0, 4))",
          "as": "Year"
        },
        {
          "type": "filter",
          "expr": "datum.Year === 2017 || datum.Year === 2025"
        },
        {
          "type": "formula",
          "expr": "datum.Year === 2017 ? datum.students : 0",
          "as": "Baseline"
        },
        {
          "type": "formula",
          "expr": "datum.Year === 2025 ? datum.students : 0",
          "as": "Latest"
        },
        {
          "type": "aggregate",
          "groupby": ["state", "stage"],
          "fields": ["Baseline", "Latest"],
          "ops": ["sum", "sum"],
          "as": ["Students2017", "Students2025"]
        },
        {
          "type": "formula",
          "expr": "datum.state + '|' + datum.stage",
          "as": "JoinKey"
        },
        {
          "type": "lookup",
          "from": "teachers",
          "key": "JoinKey",
          "fields": ["JoinKey"],
          "values": ["Teachers2017", "Teachers2025"],
          "as": ["Teachers2017", "Teachers2025"]
        },
        {
          "type": "filter",
          "expr": "datum.Students2017 > 0 && datum.Teachers2017 > 0 && isValid(datum.Teachers2025)"
        },
        {
          "type": "formula",
          "expr": "(datum.Students2025 - datum.Students2017) / datum.Students2017",
          "as": "StudentGrowth"
        },
        {
          "type": "formula",
          "expr": "(datum.Teachers2025 - datum.Teachers2017) / datum.Teachers2017",
          "as": "TeacherGrowth"
        },
        {
          "type": "formula",
          "expr": "datum.stage === 'primary' ? 'Primary' : 'Secondary'",
          "as": "Stage"
        },
        {
          "type": "formula",
          "expr": "replace(datum.state, 'W.P. ', '')",
          "as": "StateLabel"
        },
        {
          "type": "formula",
          "expr": "datum.TeacherGrowth - datum.StudentGrowth",
          "as": "GrowthGap"
        }
      ]
    },
    {
      "name": "limits",
      "source": "comparison",
      "transform": [
        {
          "type": "fold",
          "fields": ["StudentGrowth", "TeacherGrowth"],
          "as": ["Measure", "Growth"]
        },
        {
          "type": "aggregate",
          "fields": ["Growth", "Growth"],
          "ops": ["min", "max"],
          "as": ["Minimum", "Maximum"]
        },
        {
          "type": "formula",
          "expr": "min(0, datum.Minimum)",
          "as": "Lower"
        },
        {
          "type": "formula",
          "expr": "max(0, datum.Maximum)",
          "as": "Upper"
        },
        {
          "type": "fold",
          "fields": ["Lower", "Upper"],
          "as": ["Endpoint", "Growth"]
        }
      ]
    },
    {
      "name": "selected",
      "source": "comparison",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.state === selectedState"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "fields": [
          {"data": "comparison", "field": "StudentGrowth"},
          {"data": "comparison", "field": "TeacherGrowth"}
        ]
      },
      "range": "width",
      "zero": true,
      "nice": true
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "fields": [
          {"data": "comparison", "field": "StudentGrowth"},
          {"data": "comparison", "field": "TeacherGrowth"}
        ]
      },
      "range": "height",
      "zero": true,
      "nice": true
    },
    {
      "name": "stageColour",
      "type": "ordinal",
      "domain": ["Primary", "Secondary"],
      "range": ["#54278F", "#F28E2B"]
    },
    {
      "name": "stageShape",
      "type": "ordinal",
      "domain": ["Primary", "Secondary"],
      "range": ["circle", "square"]
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "title": "Enrolment change, 2017 - 2025",
      "format": ".0%",
      "grid": true,
      "gridColor": "#EEEEEE",
      "tickCount": 7
    },
    {
      "orient": "left",
      "scale": "y",
      "title": "Teacher change, 2017 - 2025",
      "format": ".0%",
      "grid": true,
      "gridColor": "#EEEEEE",
      "tickCount": 7
    }
  ],
  "legends": [
    {
      "fill": "stageColour",
      "shape": "stageShape",
      "title": "School stage",
      "orient": "right",
      "symbolSize": 100
    }
  ],
  "marks": [
    {
      "type": "line",
      "interactive": false,
      "from": {"data": "limits"},
      "sort": {"field": "datum.Growth"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "Growth"},
          "y": {"scale": "y", "field": "Growth"},
          "stroke": {"value": "#777777"},
          "strokeWidth": {"value": 1.5},
          "strokeDash": {"value": [5, 5]}
        }
      }
    },
    {
      "type": "rule",
      "interactive": false,
      "encode": {
        "update": {
          "x": {"scale": "x", "value": 0},
          "y": {"value": 0},
          "y2": {"signal": "height"},
          "stroke": {"value": "#BBBBBB"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "rule",
      "interactive": false,
      "encode": {
        "update": {
          "x": {"value": 0},
          "x2": {"signal": "width"},
          "y": {"scale": "y", "value": 0},
          "stroke": {"value": "#BBBBBB"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "comparison"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "StudentGrowth"},
          "y": {"scale": "y", "field": "TeacherGrowth"},
          "shape": {"scale": "stageShape", "field": "Stage"},
          "fill": {"scale": "stageColour", "field": "Stage"},
          "size": {
            "signal": "datum.state === selectedState ? 180 : 100"
          },
          "opacity": {
            "signal": "selectedState === 'All states' || datum.state === selectedState ? 0.85 : 0.18"
          },
          "stroke": {
            "signal": "datum.state === selectedState ? '#222222' : '#FFFFFF'"
          },
          "strokeWidth": {
            "signal": "datum.state === selectedState ? 2 : 1"
          },
          "zindex": {
            "signal": "datum.state === selectedState ? 1 : 0"
          },
          "tooltip": {
            "signal": "{'State': datum.StateLabel, 'School stage': datum.Stage, 'Students in 2017': format(datum.Students2017, ',.0f'), 'Students in 2025': format(datum.Students2025, ',.0f'), 'Enrolment change': format(datum.StudentGrowth, '+.1%'), 'Teachers in 2017': format(datum.Teachers2017, ',.0f'), 'Teachers in 2025': format(datum.Teachers2025, ',.0f'), 'Teacher change': format(datum.TeacherGrowth, '+.1%'), 'Teacher minus enrolment growth (percentage points)': format(datum.GrowthGap * 100, '+.1f')}"
          }
        },
        "hover": {
          "opacity": {"value": 1},
          "stroke": {"value": "#222222"},
          "strokeWidth": {"value": 2}
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {"data": "selected"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "StudentGrowth"},
          "y": {"scale": "y", "field": "TeacherGrowth"},
          "text": {
            "signal": "datum.StateLabel + ' — ' + datum.Stage"
          },
          "align": {
            "signal": "scale('x', datum.StudentGrowth) > width / 2 ? 'right' : 'left'"
          },
          "dx": {
            "signal": "scale('x', datum.StudentGrowth) > width / 2 ? -10 : 10"
          },
          "dy": {
            "signal": "datum.stage === 'primary' ? -13 : 17"
          },
          "fontSize": {"value": 11},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#333333"}
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "domain": false,
      "tickColor": "#CCCCCC"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}