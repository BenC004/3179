{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": {"expr": "'Who are the students in ' + replace(selectedState, 'W.P. ', '') + '?'"},
    "subtitle": [
      "Government primary and secondary school enrolment, 2025",
      "Column width shows stage share; section height shows male/female share within that stage."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13
  },
  "width": 800,
  "height": 500,
  "data": {"url": "../source1/enrolment_school_district.csv", "format": {"type": "csv", "parse": {"students": "number"}}},
  "params": [
    {
      "name": "selectedState",
      "value": "Malaysia",
      "bind": {
        "input": "select",
        "name": "Selected state: ",
        "options": [
          "Malaysia", "Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan",
          "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak", "Selangor", 
          "Terengganu", "W.P. Kuala Lumpur", "W.P. Labuan", "W.P. Putrajaya"
        ],
        "labels": [
          "Malaysia", "Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan",
          "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak", "Selangor", 
          "Terengganu", "Kuala Lumpur", "Labuan", "Putrajaya"
        ]
      }
    }
  ],
  "transform": [
    {"filter": "datum.state === selectedState"},
    {"filter": "datum.district === 'All Districts'"},
    {"filter": "datum.sex === 'male' || datum.sex === 'female'"},
    {"filter": "datum.stage === 'primary' || datum.stage === 'secondary'"},
    {"calculate": "toNumber(substring(datum.date, 0, 4))", "as": "Year"},
    {"filter": "datum.Year === 2025"},
    {
      "aggregate": [{"op": "sum", "field": "students", "as": "Students"}],
      "groupby": ["state", "stage", "sex"]
    },
    {
      "joinaggregate": [{"op": "sum", "field": "Students", "as": "Stage Students"}],
      "groupby": ["stage"]
    },
    {"calculate": "datum.stage === 'primary' ? datum.Students : 0", "as": "Primary Students"},
    {
      "joinaggregate": [
        {"op": "sum", "field": "Students", "as": "Total Students"},
        {"op": "sum", "field": "Primary Students", "as": "Primary Total"}
      ]
    },
    {"calculate": "datum.stage === 'primary' ? 'Primary' : 'Secondary'", "as": "School Stage"},
    {"calculate": "datum.sex === 'male' ? 'Male' : 'Female'", "as": "Sex"},
    {"calculate": "datum['Stage Students'] / datum['Total Students']", "as": "Stage Share"},
    {"calculate": "datum.Students / datum['Stage Students']", "as": "Sex Share"},
    {"calculate": "datum.Students / datum['Total Students']", "as": "Overall Share"},
    {"calculate": "datum.stage === 'primary' ? 0 : datum['Primary Total'] / datum['Total Students']", "as": "X Start"},
    {"calculate": "datum.stage === 'primary' ? datum['Primary Total'] / datum['Total Students'] : 1", "as": "X End"},
    {
      "stack": "Students",
      "groupby": ["stage"],
      "sort": [{"field": "sex", "order": "descending"}],
      "offset": "normalize",
      "as": ["Y Start", "Y End"]
    },
    {"calculate": "(datum['X Start'] + datum['X End']) / 2", "as": "X Centre"},
    {"calculate": "(datum['Y Start'] + datum['Y End']) / 2", "as": "Y Centre"},
    {"calculate": "datum.Sex + '\\n' + format(datum['Sex Share'], '.1%')", "as": "Section Label"},
    {"calculate": "datum['School Stage'] + ' (' + format(datum['Stage Share'], '.1%') + ')'", "as": "Stage Label"}
  ],
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#FFFFFF", "strokeWidth": 2},
      "encoding": {
        "x": {
          "field": "X Start", "type": "quantitative",
          "scale": {"domain": [0, 1], "nice": false},
          "axis": null
        },
        "x2": {"field": "X End"},
        "y": {
          "field": "Y Start", "type": "quantitative",
          "scale": {"domain": [0, 1], "nice": false},
          "axis": {
            "title": "Share within school stage",
            "format": ".0%",
            "values": [0, 0.25, 0.5, 0.75, 1],
            "grid": false
          }
        },
        "y2": {"field": "Y End"},
        "color": {
          "field": "Sex", "type": "nominal",
          "scale": {"domain": ["Male", "Female"], "range": ["#4E79A7", "#CC7A91"]},
          "legend": {"title": "Sex", "orient": "right"}
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "Location"},
          {"field": "School Stage", "type": "nominal", "title": "School stage"},
          {"field": "Sex", "type": "nominal", "title": "Sex"},
          {"field": "Students", "type": "quantitative", "title": "Students", "format": ",.0f"},
          {"field": "Sex Share", "type": "quantitative", "title": "Share within this stage", "format": ".1%"},
          {"field": "Stage Share", "type": "quantitative", "title": "Stage share of all students", "format": ".1%"},
          {"field": "Overall Share", "type": "quantitative", "title": "Section share of all students", "format": ".1%"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 16, "fontWeight": "bold", "lineBreak": "\n", "lineHeight": 24},
      "encoding": {
        "x": {"field": "X Centre", "type": "quantitative", "axis": null},
        "y": {"field": "Y Centre", "type": "quantitative", "axis": null},
        "text": {"field": "Section Label", "type": "nominal"},
        "color": {"value": "#FFFFFF"}
      }
    },
    {
      "transform": [{"filter": "datum.sex === 'male'"}],
      "mark": {"type": "text", "fontSize": 14, "fontWeight": "bold", "baseline": "top", "color": "#222222"},
      "encoding": {
        "x": {"field": "X Centre", "type": "quantitative", "axis": null},
        "y": {"value": 515},
        "text": {"field": "Stage Label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 13, "domain": false, "tickColor": "#CCCCCC"},
    "legend": {"labelFontSize": 12, "titleFontSize": 13}
  }
}