{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
  "text": {
    "expr": "'Who are the students in ' + replace(selectedState, 'W.P. ', '') + '?'"
  },
  "subtitle": [
    "Government primary and secondary enrolment, 2025.",
    "Each square represents 1% within its school stage.",
    "Blue = boys; pink = girls. Hover for exact values."
  ],
  "anchor": "start",
  "fontSize": 20,
  "subtitleFontSize": 12
},

  "data": {
    "url": "../source1/enrolment_school_district.csv",
    "format": {
      "type": "csv",
      "parse": {
        "students": "number"
      }
    }
  },

  "params": [
    {
      "name": "selectedState",
      "value": "Malaysia",
      "bind": {
        "input": "select",
        "name": "Selected state: ",
        "options": [
          "Malaysia",
          "Johor",
          "Kedah",
          "Kelantan",
          "Melaka",
          "Negeri Sembilan",
          "Pahang",
          "Perak",
          "Perlis",
          "Pulau Pinang",
          "Sabah",
          "Sarawak",
          "Selangor",
          "Terengganu",
          "W.P. Kuala Lumpur",
          "W.P. Labuan",
          "W.P. Putrajaya"
        ],
        "labels": [
          "Malaysia",
          "Johor",
          "Kedah",
          "Kelantan",
          "Melaka",
          "Negeri Sembilan",
          "Pahang",
          "Perak",
          "Perlis",
          "Pulau Pinang",
          "Sabah",
          "Sarawak",
          "Selangor",
          "Terengganu",
          "Kuala Lumpur",
          "Labuan",
          "Putrajaya"
        ]
      }
    }
  ],

  "transform": [
    {
      "filter": "datum.state === selectedState"
    },
    {
      "filter": "datum.district === 'All Districts'"
    },
    {
      "filter": "datum.sex === 'male' || datum.sex === 'female'"
    },
    {
      "filter": "datum.stage === 'primary' || datum.stage === 'secondary'"
    },
    {
      "calculate": "toNumber(substring(datum.date, 0, 4))",
      "as": "Year"
    },
    {
      "filter": "datum.Year === 2025"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "students",
          "as": "Students"
        }
      ],
      "groupby": [
        "state",
        "stage",
        "sex"
      ]
    },
    {
      "calculate": "datum.sex === 'male' ? datum.Students : 0",
      "as": "MaleStudents"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Students",
          "as": "TotalStudents"
        },
        {
          "op": "sum",
          "field": "MaleStudents",
          "as": "Boys"
        }
      ],
      "groupby": [
        "state",
        "stage"
      ]
    },
    {
      "filter": "datum.TotalStudents > 0"
    },
    {
      "calculate": "datum.TotalStudents - datum.Boys",
      "as": "Girls"
    },
    {
      "calculate": "datum.Boys / datum.TotalStudents",
      "as": "BoysShare"
    },
    {
      "calculate": "datum.Girls / datum.TotalStudents",
      "as": "GirlsShare"
    },
    {
      "calculate": "datum.stage === 'primary' ? 'Primary' : 'Secondary'",
      "as": "SchoolStage"
    },
    {
      "calculate": "replace(datum.state, 'W.P. ', '')",
      "as": "Location"
    },
    {
      "calculate": "sequence(0, 100)",
      "as": "Cells"
    },
    {
      "flatten": [
        "Cells"
      ],
      "as": [
        "Cell"
      ]
    },
    {
      "calculate": "datum.Cell % 10",
      "as": "Column"
    },
    {
      "calculate": "floor(datum.Cell / 10)",
      "as": "Row"
    },
    {
      "calculate": "clamp(datum.BoysShare * 100 - datum.Cell, 0, 1)",
      "as": "BoysFraction"
    },
    {
      "fold": [
        "Boys",
        "Girls"
      ],
      "as": [
        "Sex",
        "GroupStudents"
      ]
    },
    {
      "calculate": "datum.Sex === 'Boys' ? datum.BoysShare : datum.GirlsShare",
      "as": "Share"
    },
    {
      "calculate": "datum.Sex === 'Boys' ? datum.Column : datum.Column + datum.BoysFraction",
      "as": "XStart"
    },
    {
      "calculate": "datum.Sex === 'Boys' ? datum.Column + datum.BoysFraction : datum.Column + 1",
      "as": "XEnd"
    },
    {
      "calculate": "datum.Row + 1",
      "as": "YEnd"
    },
    {
      "calculate": "datum.SchoolStage + ' | Boys ' + format(datum.BoysShare, '.1%') + ' · Girls ' + format(datum.GirlsShare, '.1%')",
      "as": "PanelTitle"
    },
    {
      "filter": "datum.XEnd > datum.XStart"
    }
  ],

  "facet": {
    "column": {
      "field": "PanelTitle",
      "type": "nominal",
      "sort": "ascending",
      "header": {
        "title": null,
        "labelExpr": "split(datum.value, ' | ')",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelPadding": 12,
        "labelLineHeight": 18
      }
    }
  },

  "spacing": 24,

  "spec": {
    "width": 220,
    "height": 220,

    "mark": {
      "type": "rect",
      "stroke": "#EEF4F8",
      "strokeWidth": 1.5
    },

    "encoding": {
      "x": {
        "field": "XStart",
        "type": "quantitative",
        "scale": {
          "domain": [0, 10],
          "nice": false,
          "zero": false
        },
        "axis": null
      },
      "x2": {
        "field": "XEnd"
      },
      "y": {
        "field": "Row",
        "type": "quantitative",
        "scale": {
          "domain": [0, 10],
          "reverse": true,
          "nice": false,
          "zero": false
        },
        "axis": null
      },
      "y2": {
        "field": "YEnd"
      },
      "color": {
        "field": "Sex",
        "type": "nominal",
        "scale": {
          "domain": [
            "Boys",
            "Girls"
          ],
          "range": [
            "#4E79A7",
            "#CC7A91"
          ]
        },
        "legend": {
          "title": null,
          "orient": "bottom",
          "direction": "horizontal"
        }
      },
      "tooltip": [
        {
          "field": "Location",
          "type": "nominal",
          "title": "Location"
        },
        {
          "field": "SchoolStage",
          "type": "nominal",
          "title": "School stage"
        },
        {
          "field": "Sex",
          "type": "nominal",
          "title": "Sex"
        },
        {
          "field": "GroupStudents",
          "type": "quantitative",
          "title": "Students in this group",
          "format": ",.0f"
        },
        {
          "field": "Share",
          "type": "quantitative",
          "title": "Share within this stage",
          "format": ".2%"
        },
        {
          "field": "TotalStudents",
          "type": "quantitative",
          "title": "Total students in this stage",
          "format": ",.0f"
        }
      ]
    }
  },

  "resolve": {
    "scale": {
      "color": "shared"
    }
  },

  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "symbolSize": 100
    }
  }
}