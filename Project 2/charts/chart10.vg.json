{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 800,
  "height": 520,
  "padding": 25,
  "title": {
    "text": "How are schools distributed relative to student numbers?",
    "subtitle": [
      "Government primary and secondary schools by state, 2025",
      "State shape area = school count; darker purple = more students per school.",
      "Shapes are resized and separated; geographic positions are approximate."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13
  },
  "signals": [
    {
      "name": "pixelsPerSchool",
      "value": 3
    }
  ],
  "projections": [
    {
      "name": "outlineProjection",
      "type": "mercator",
      "scale": 1000,
      "center": [109, 4],
      "translate": [0, 0],
      "precision": 0.1
    }
  ],
  "data": [
    {
      "name": "schoolTotals",
      "url": "../source1/schools_district.csv",
      "format": {
        "type": "csv",
        "parse": {"schools": "number"}
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.state !== 'Malaysia' && datum.district === 'All Districts'"
        },
        {
          "type": "filter",
          "expr": "datum.date === '2025-06-30' && (datum.stage === 'primary' || datum.stage === 'secondary')"
        },
        {
          "type": "aggregate",
          "groupby": ["state"],
          "fields": ["schools"],
          "ops": ["sum"],
          "as": ["Schools"]
        }
      ]
    },
    {
      "name": "studentTotals",
      "url": "../source1/enrolment_school_district.csv",
      "format": {
        "type": "csv",
        "parse": {"students": "number"}
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.state !== 'Malaysia' && datum.district === 'All Districts' && datum.sex === 'both'"
        },
        {
          "type": "filter",
          "expr": "datum.date === '2025-06-30' && (datum.stage === 'primary' || datum.stage === 'secondary')"
        },
        {
          "type": "aggregate",
          "groupby": ["state"],
          "fields": ["students"],
          "ops": ["sum"],
          "as": ["Students"]
        }
      ]
    },
    {
      "name": "cartogram",
      "url": "../maps/administrative_1_state.geojson",
      "format": {
        "type": "json",
        "property": "features"
      },
      "transform": [
        {
          "type": "formula",
          "expr": "datum.properties.state",
          "as": "State"
        },
        {
          "type": "lookup",
          "from": "schoolTotals",
          "key": "state",
          "fields": ["State"],
          "values": ["Schools"],
          "as": ["Schools"]
        },
        {
          "type": "lookup",
          "from": "studentTotals",
          "key": "state",
          "fields": ["State"],
          "values": ["Students"],
          "as": ["Students"]
        },
        {
          "type": "filter",
          "expr": "datum.Schools > 0 && isValid(datum.Students)"
        },
        {
          "type": "formula",
          "expr": "datum.Students / datum.Schools",
          "as": "StudentsPerSchool"
        },
        {
          "type": "formula",
          "expr": "geoArea('outlineProjection', datum)",
          "as": "OriginalArea"
        },
        {
          "type": "formula",
          "expr": "geoCentroid('outlineProjection', datum)",
          "as": "ProjectedCentre"
        },
        {
          "type": "formula",
          "expr": "geoCentroid(null, datum)",
          "as": "GeographicCentre"
        },
        {
          "type": "formula",
          "expr": "geoBounds('outlineProjection', datum)",
          "as": "Bounds"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.OriginalArea) && datum.OriginalArea > 0"
        },
        {
          "type": "formula",
          "expr": "sqrt(datum.Schools * pixelsPerSchool / datum.OriginalArea)",
          "as": "ScaleFactor"
        },
        {
          "type": "formula",
          "expr": "max(abs(datum.Bounds[0][0] - datum.ProjectedCentre[0]), abs(datum.Bounds[1][0] - datum.ProjectedCentre[0])) * datum.ScaleFactor",
          "as": "HalfWidth"
        },
        {
          "type": "formula",
          "expr": "max(abs(datum.Bounds[0][1] - datum.ProjectedCentre[1]), abs(datum.Bounds[1][1] - datum.ProjectedCentre[1])) * datum.ScaleFactor",
          "as": "HalfHeight"
        },
        {
          "type": "formula",
          "expr": "sqrt(datum.HalfWidth * datum.HalfWidth + datum.HalfHeight * datum.HalfHeight) + 8",
          "as": "CollisionRadius"
        },
        {
          "type": "formula",
          "expr": "datum.GeographicCentre[0] < 105 ? 90 + (datum.GeographicCentre[0] - 100) * 85 : 520 + (datum.GeographicCentre[0] - 112) * 35",
          "as": "AnchorX"
        },
        {
          "type": "formula",
          "expr": "70 + (7 - datum.GeographicCentre[1]) * 65",
          "as": "AnchorY"
        },
        {
          "type": "formula",
          "expr": "datum.AnchorX",
          "as": "x"
        },
        {
          "type": "formula",
          "expr": "datum.AnchorY",
          "as": "y"
        },
        {
          "type": "formula",
          "expr": "indexof(datum.State, 'W.P. ') === 0",
          "as": "ExternalLabel"
        },
        {
          "type": "formula",
          "expr": "datum.State === 'Pulau Pinang' ? 'Penang' : datum.State === 'Negeri Sembilan' ? 'N. Sembilan' : replace(datum.State, 'W.P. ', '')",
          "as": "Label"
        },
        {
          "type": "geopath",
          "projection": "outlineProjection",
          "as": "StatePath"
        },
        {
          "type": "force",
          "static": true,
          "iterations": 600,
          "forces": [
            {
              "force": "x",
              "x": "AnchorX",
              "strength": 0.08
            },
            {
              "force": "y",
              "y": "AnchorY",
              "strength": 0.08
            },
            {
              "force": "collide",
              "radius": {"expr": "datum.CollisionRadius"},
              "strength": 1,
              "iterations": 5
            }
          ]
        },
        {
          "type": "formula",
          "expr": "datum.x - datum.ProjectedCentre[0] * datum.ScaleFactor",
          "as": "DrawX"
        },
        {
          "type": "formula",
          "expr": "datum.y - datum.ProjectedCentre[1] * datum.ScaleFactor",
          "as": "DrawY"
        },
        {
          "type": "formula",
          "expr": "datum.State === 'W.P. Labuan' ? 1 : -1",
          "as": "LabelDirection"
        },
        {
          "type": "formula",
          "expr": "datum.x + datum.LabelDirection * (datum.CollisionRadius + 18)",
          "as": "LabelX"
        },
        {
          "type": "formula",
          "expr": "datum.y + (datum.State === 'W.P. Putrajaya' ? 16 : -12)",
          "as": "LabelY"
        }
      ]
    },
    {
      "name": "internalLabels",
      "source": "cartogram",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.ExternalLabel"
        }
      ]
    },
    {
      "name": "externalLabels",
      "source": "cartogram",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.ExternalLabel"
        }
      ]
    },
    {
      "name": "regions",
      "values": [
        {"label": "Peninsular Malaysia", "x": 240},
        {"label": "East Malaysia", "x": 640}
      ]
    }
  ],
  "scales": [
    {
      "name": "ratioColour",
      "type": "linear",
      "domain": {
        "data": "cartogram",
        "field": "StudentsPerSchool"
      },
      "range": ["#F2EDF8", "#54278F"],
      "zero": false,
      "nice": false
    },
    {
      "name": "schoolArea",
      "type": "linear",
      "domain": [0, 1000],
      "range": [0, {"signal": "1000 * pixelsPerSchool"}],
      "zero": true
    }
  ],
  "legends": [
    {
      "fill": "ratioColour",
      "title": "Students per school",
      "orient": "bottom",
      "direction": "horizontal",
      "gradientLength": 280,
      "format": ",.0f"
    },
    {
      "size": "schoolArea",
      "title": "Schools: equal-area reference squares",
      "orient": "right",
      "values": [100, 500, 1000],
      "format": ",.0f",
      "symbolType": "square",
      "symbolFillColor": "#DDDDDD",
      "symbolStrokeColor": "#777777"
    }
  ],
  "marks": [
    {
      "type": "text",
      "interactive": false,
      "from": {"data": "regions"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"value": 15},
          "text": {"field": "label"},
          "align": {"value": "center"},
          "fontSize": {"value": 14},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#555555"}
        }
      }
    },
    {
      "type": "path",
      "from": {"data": "cartogram"},
      "encode": {
        "update": {
          "path": {"field": "StatePath"},
          "x": {"field": "DrawX"},
          "y": {"field": "DrawY"},
          "scaleX": {"field": "ScaleFactor"},
          "scaleY": {"field": "ScaleFactor"},
          "fill": {
            "scale": "ratioColour",
            "field": "StudentsPerSchool"
          },
          "stroke": {"value": "#777777"},
          "strokeWidth": {
            "signal": "0.7 / datum.ScaleFactor"
          },
          "strokeJoin": {"value": "round"},
          "tooltip": {
            "signal": "{'State': datum.State, 'Year': 2025, 'Schools': format(datum.Schools, ',.0f'), 'Students': format(datum.Students, ',.0f'), 'Students per school': format(datum.StudentsPerSchool, ',.1f')}"
          }
        },
        "hover": {
          "stroke": {"value": "#222222"},
          "strokeWidth": {
            "signal": "2 / datum.ScaleFactor"
          }
        }
      }
    },
    {
      "type": "rule",
      "interactive": false,
      "from": {"data": "externalLabels"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "x2": {"field": "LabelX"},
          "y2": {"field": "LabelY"},
          "stroke": {"value": "#777777"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {"data": "internalLabels"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "text": {"field": "Label"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#FFFFFF"},
          "stroke": {"value": "#FFFFFF"},
          "strokeWidth": {"value": 3}
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {"data": "internalLabels"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "text": {"field": "Label"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 11},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#222222"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "externalLabels"},
      "encode": {
        "update": {
          "x": {"field": "LabelX"},
          "y": {"field": "LabelY"},
          "text": {"field": "Label"},
          "align": {
            "signal": "datum.LabelDirection > 0 ? 'left' : 'right'"
          },
          "baseline": {"value": "middle"},
          "dx": {
            "signal": "datum.LabelDirection * 4"
          },
          "fontSize": {"value": 11},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#222222"},
          "tooltip": {
            "signal": "{'State': datum.State, 'Schools': format(datum.Schools, ',.0f'), 'Students': format(datum.Students, ',.0f'), 'Students per school': format(datum.StudentsPerSchool, ',.1f')}"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}